// Copied to Secrets.xcconfig by scripts/write-secrets.sh from ../.env.local.
// `//` starts a comment in xcconfig files, so URLs are written as `https:/$()/`.
SUPABASE_URL = https:/$()/your-project.supabase.co
SUPABASE_ANON_KEY = your-anon-key
APP_URL = https:/$()/your-app.example.com
// Scaled Sync, where people's passwords live (one login for both apps).
SYNC_SUPABASE_URL = https:/$()/your-scaled-sync-project.supabase.co
SYNC_SUPABASE_ANON_KEY = your-scaled-sync-anon-key
SYNC_APP_URL = https:/$()/scaled-sync-production.up.railway.app
